{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d38999-pinout-lib/schema/arrangement.schema.json",
  "title": "Arrangement geometry model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "family",
    "prefix",
    "number",
    "canvas",
    "contacts",
    "status",
    "revision"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}[0-9]{1,3}$"
    },
    "family": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "prefix": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}$"
    },
    "number": {
      "type": "string",
      "pattern": "^[0-9]{1,3}$"
    },
    "title": {
      "type": "string"
    },
    "viewCaption": {
      "type": [
        "string",
        "null"
      ]
    },
    "expectedContacts": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "insert": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "cx",
        "cy",
        "r"
      ],
      "properties": {
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "cx",
          "cy",
          "r"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "cx": {
            "type": "number"
          },
          "cy": {
            "type": "number"
          },
          "r": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "style": {
            "enum": [
              "hollow",
              "filled"
            ]
          },
          "text": {
            "$ref": "#/$defs/textPlacement"
          }
        }
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "x1",
              "y1",
              "x2",
              "y2"
            ],
            "properties": {
              "type": {
                "const": "line"
              },
              "x1": {
                "type": "number"
              },
              "y1": {
                "type": "number"
              },
              "x2": {
                "type": "number"
              },
              "y2": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "cx",
              "cy",
              "r"
            ],
            "properties": {
              "type": {
                "const": "circle"
              },
              "cx": {
                "type": "number"
              },
              "cy": {
                "type": "number"
              },
              "r": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fill": {
                "type": "boolean"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "d"
            ],
            "properties": {
              "type": {
                "const": "path"
              },
              "d": {
                "type": "string",
                "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE.,+\\- ]+$"
              },
              "fill": {
                "type": "boolean"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        ]
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "x",
          "y"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "anchor": {
            "enum": [
              "start",
              "middle",
              "end"
            ]
          },
          "rotate": {
            "type": "number"
          }
        }
      }
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "qa": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "rejected"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "series": {
      "type": [
        "string",
        "null"
      ]
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ]
    },
    "partNumbers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shell": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  },
  "$defs": {
    "textPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "anchor": {
          "enum": [
            "start",
            "middle",
            "end"
          ]
        },
        "rotate": {
          "type": "number"
        }
      }
    }
  }
}
